# @variegated-coffee/ui and serde-postcard-ts are published to GitHub Packages.
# Registry selection is per-scope, not per-package, so this necessarily routes
# every @variegated-coffee dependency there -- both are mirrored accordingly.
#
# GitHub Packages demands a token even though both packages are public, so an
# install needs one with read:packages:
#
#   export NPM_TOKEN=$(gh auth token)
#
# The token is read from the environment rather than kept here, because this file
# is committed. Note that NPM_TOKEN must be set even if you already have a token
# in ~/.npmrc: this line overrides the user-level one, and when the variable is
# unset npm sends the literal string "${NPM_TOKEN}" and the registry 401s.
@variegated-coffee:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
